    <worksheet name='Funnel - Step Rates'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Step rates compare visitor counts per stage. Some buyers have no recorded cart event, so these are indicators, not a strict funnel.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dash_funnel' name='federated.0yi5dqy0yx2hn415ja0xr0vmrkpx' />
          </datasources>
          <datasource-dependencies datasource='federated.0yi5dqy0yx2hn415ja0xr0vmrkpx'>
            <column caption='Viewed to Cart (visitors)' datatype='real' name='[Calculation_3883252765323267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stage_order]=2 THEN [visitors] END) / SUM(IF [stage_order]=1 THEN [visitors] END)' />
            </column>
            <column caption='Cart to Purchase (visitors)' datatype='real' name='[Calculation_3883252765630468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stage_order]=3 THEN [visitors] END) / SUM(IF [stage_order]=2 THEN [visitors] END)' />
            </column>
            <column caption='Viewed to Purchase (visitors)' datatype='real' name='[Calculation_3883252765745157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stage_order]=3 THEN [visitors] END) / SUM(IF [stage_order]=1 THEN [visitors] END)' />
            </column>
            <column caption='Stage Order' datatype='integer' name='[stage_order]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3883252765323267]' derivation='User' name='[usr:Calculation_3883252765323267:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3883252765630468]' derivation='User' name='[usr:Calculation_3883252765630468:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3883252765745157]' derivation='User' name='[usr:Calculation_3883252765745157:qk]' pivot='key' type='quantitative' />
            <column caption='Visitors' datatype='real' name='[visitors]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0yi5dqy0yx2hn415ja0xr0vmrkpx].[:Measure Names]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0yi5dqy0yx2hn415ja0xr0vmrkpx].[usr:Calculation_3883252765630468:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0yi5dqy0yx2hn415ja0xr0vmrkpx].[usr:Calculation_3883252765323267:qk]&quot;' />
