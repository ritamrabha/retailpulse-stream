    <worksheet name='Funnel - Visitors'>
      <table>
        <view>
          <datasources>
            <datasource caption='dash_funnel' name='federated.0yi5dqy0yx2hn415ja0xr0vmrkpx' />
          </datasources>
          <datasource-dependencies datasource='federated.0yi5dqy0yx2hn415ja0xr0vmrkpx'>
            <column caption='Visitors % of Viewers' datatype='real' name='[Calculation_3883252758511617]' role='measure' type='quantitative'>
