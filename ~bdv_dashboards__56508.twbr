    <worksheet name='Category Map'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Categories with at least 1,000 events. Box size = events, colour = carts per 100 views</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dash_category' name='federated.1fz1uxy0kvmgl41aeap760ujtpdc' />
          </datasources>
          <datasource-dependencies datasource='federated.1fz1uxy0kvmgl41aeap760ujtpdc'>
            <column caption='Category' datatype='string' name='[Calculation_3883252782538759]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [category_id] = -1 THEN &quot;No category&quot; ELSE &quot;Category &quot; + STR([category_id]) END' />
            </column>
            <column caption='Carts per 100 Views' datatype='real' name='[Calculation_3883252782714888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * SUM([carts]) / SUM([views])' />
            </column>
            <column caption='Carts' datatype='integer' name='[carts]' role='measure' type='quantitative' />
            <column caption='Category Id' datatype='integer' name='[category_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3883252782538759]' derivation='None' name='[none:Calculation_3883252782538759:nk]' pivot='key' type='nominal' />
            <column-instance column='[total_events]' derivation='Sum' name='[sum:total_events:qk]' pivot='key' type='quantitative' />
            <column caption='Total Events' datatype='integer' name='[total_events]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3883252782714888]' derivation='User' name='[usr:Calculation_3883252782714888:qk]' pivot='key' type='quantitative' />
            <column caption='Views' datatype='integer' name='[views]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1fz1uxy0kvmgl41aeap760ujtpdc].[sum:total_events:qk]' included-values='in-range'>
            <min>1000</min>
          </filter>
          <slices>
            <column>[federated.1fz1uxy0kvmgl41aeap760ujtpdc].[sum:total_events:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.1fz1uxy0kvmgl41aeap760ujtpdc].[usr:Calculation_3883252782714888:qk]' />
              <size column='[federated.1fz1uxy0kvmgl41aeap760ujtpdc].[sum:total_events:qk]' />
              <text column='[federated.1fz1uxy0kvmgl41aeap760ujtpdc].[none:Calculation_3883252782538759:nk]' />
              <lod column='[federated.1fz1uxy0kvmgl41aeap760ujtpdc].[none:Calculation_3883252782538759:nk]' />
            </encodings>
            <style>
