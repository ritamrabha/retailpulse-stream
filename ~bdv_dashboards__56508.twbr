            <column caption='Top Level Label' datatype='string' name='[top_level_label]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3883252782714888]' derivation='User' name='[usr:Calculation_3883252782714888:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3883252782796809]' derivation='User' name='[usr:Calculation_3883252782796809:qk]' pivot='key' type='quantitative' />
            <column caption='Views' datatype='integer' name='[views]' role='measure' type='quantitative' />
