# Copy this file to ".env" and set your own values. The real ".env" is ignored by git. Never commit it.
MYSQL_ROOT_PASSWORD=change_me_root_pw
TABLEAU_RO_PASSWORD=change_me_tableau_pw
NEO4J_PASSWORD=change_me_neo4j_pw        # at least 8 characters
JUPYTER_TOKEN=change_me_lab_token        # the "password" for http://localhost:8888

# Optional (defaults shown). Lower these if Docker has less than 8 GB of RAM.
# MYSQL_BUFFER_POOL=1G
# NEO4J_HEAP=2G
# NEO4J_PAGECACHE=2G
# MYSQL_HOST_PORT=3307
# NEO4J_BROWSER_PORT=7475
# NEO4J_BOLT_PORT=7688
# LAB_PORT=8888
